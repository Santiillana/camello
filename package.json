{
  "name": "camello",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-sql-wasm.mjs",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/copy-sql-wasm.mjs",
    "postinstall": "node scripts/copy-sql-wasm.mjs",
    "lint": "oxlint src vite.config.ts capacitor.config.ts scripts",
    "verify": "npm run typecheck && npm run lint && npm run verify:vitest && npm run verify:db && npm run verify:modulos && npm run verify:security && npm run verify:ubicacion && npm run benchmark:db && npm run benchmark:scale && npm run verify:e2e",
    "preview": "vite preview",
    "verify:db": "node --experimental-strip-types scripts/verify-db.mjs",
    "benchmark:db": "node scripts/benchmark-db.mjs",
    "verify:ubicacion": "node --experimental-strip-types scripts/verify-ubicacion.ts",
    "verify:security": "node --experimental-strip-types scripts/verify-security.ts",
    "verify:modulos": "node scripts/verify-modulos.mjs",
    "e2e": "node scripts/e2e-core.mjs",
    "benchmark:scale": "node scripts/benchmark-scale.mjs",
    "typecheck": "tsc -b --pretty false",
    "verify:vitest": "vitest run",
    "verify:e2e": "playwright install chromium && timeout --signal=TERM --kill-after=30s 12m node scripts/e2e-core.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@types/leaflet": "1.9.22",
    "jeep-sqlite": "2.8.0",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "sql.js": "1.11.0",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/app": "8.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.85.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "playwright": "1.63.0",
    "jsdom": "30.1.1",
    "fake-indexeddb": "6.2.5",
    "@types/sql.js": "1.4.9"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
